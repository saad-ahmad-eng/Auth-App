# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.vscode/settings.json.bak
.idea/
*.iml
bin/

# OS
.DS_Store

# Editor swap/session files
*.swp
.claude/

# Logs / runtime artifacts produced by the server (Security.md §9, Audit Logger)
*.log
audit.log

# Vault storage — never commit uploaded/stored file content (Architecture.md §2.10)
vault-storage/

# Local-only config that may carry secrets/keys (Security.md — never hardcode secrets)
*.local.properties

# Generated AES-256 shared key (SharedKeyProvider, ADR-007/OQ-05) — dev-only,
# regenerated per environment, never committed
authlock-shared.key
*.key

# EC2 SSH private keys — never commit
*.pem

# Phase 13 admin panel: runtime-created/modified accounts (UserStore) — hashed
# passwords, not plaintext, but still generated per-environment state, never committed
authlock-users.properties

# Generated TLS dev keystore/truststore (RMI-over-TLS, ADR-007/OQ-05)
certs/

# Terraform (Phase 11 — terraform/) — state can contain resource attributes
# best kept out of git, and these are all regenerated/local-only anyway
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/*.tfvars.json
terraform/crash.log
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json
